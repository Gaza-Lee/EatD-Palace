<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EatDPalaceMobile.Views.GeneralPages.CreateAccountPage"
             Title="CreateAccountPage"
             Shell.NavBarIsVisible="False">
    <Grid >
        <Image Source="bgimg3.jpg"
               Aspect="AspectFill"
               Opacity="0.8"/>
        <BoxView Opacity="0.6"/>
        
        <Grid Margin="5, 10" RowSpacing="10"
              RowDefinitions="auto,auto,auto, auto, auto,auto,auto, auto, *"
              HorizontalOptions="Center">
            <VerticalStackLayout Grid.Row="0" Spacing="-5"
                                 Margin="0,0,0,20">
                <Label Text="Create Account"
                       FontFamily="MontserratBold"
                       FontSize="25"
                       FontAttributes="Bold"
                       CharacterSpacing="2"/>
                <Label Text="To get Started!! Create Account" />
                <Label Text="You can provide both or just 1 (Email/PhoneNumber). But at least one is required" 
                       TextColor="Red"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0"
                       FontSize="Caption"
                       FontFamily="MontserratRegular"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1">
                <Label Text="Name"/>
                <Entry Placeholder="Enter FullName" 
                       TextColor="#ffffff"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="2">
                <Label Text="Email (optional)"/>
                <Entry Placeholder="Enter FullName" 
                       TextColor="#ffffff"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="3">
                <Label Text="Phone Number"/>
                <Entry Placeholder="Enter FullName" 
                       TextColor="#ffffff"/>
            </VerticalStackLayout>

            <Grid Grid.Row="4"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Password"/>
                    <Entry Placeholder="Enter FullName" 
                            TextColor="#ffffff"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Confirm Password"/>
                    <Entry Placeholder="Enter FullName" 
                           TextColor="#ffffff"/>
                </VerticalStackLayout>
            </Grid>

            <Button Grid.Row="5"
                    HorizontalOptions="Center"
                    Text="Create Account"
                    CornerRadius="100"
                    Padding="50,0"
                    Command="{Binding CreateAccountCommand}"/>

            <HorizontalStackLayout Grid.Row="6" HorizontalOptions="Center"
                       Spacing="5">
                <Border VerticalOptions="Center"
                        HeightRequest="5"
                        WidthRequest="150"
                        Background="#fff"/>
                <Label Text="Or With" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Border VerticalOptions="Center"
                        HeightRequest="5"
                        WidthRequest="150"
                        Background="#fff"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Row="7"
                       HorizontalOptions="Center"
                       Spacing="50">
                <Border Padding="20,5"
                        StrokeShape="RoundRectangle 100"
                        BackgroundColor="#33F7F7F7">
                    <Border.Shadow>
                        <Shadow Offset="5,5"
                                Brush="Gray"/>
                    </Border.Shadow>
                    <Label Text="Facebook" 
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="25"/>
                </Border>
                <Border Padding="20,5"
                        StrokeShape="RoundRectangle 100"
                        BackgroundColor="#33f7f7f7">
                    <Border.Shadow>
                        <Shadow Brush="Gray"
                    Offset="5,5"/>
                    </Border.Shadow>
                    <Label Text="Google"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="25"/>
                </Border>
            </HorizontalStackLayout>

            <Border Grid.Row="8"
                    StrokeShape="RoundRectangle 2"
                    Padding="10,5"
                    StrokeThickness="0.2"
                    VerticalOptions="End"
                    BackgroundColor="#33f7f7f7"
                    HorizontalOptions="Center">
                <HorizontalStackLayout  VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Spacing="5">
                    <Label Text="Already have an account?"
                           VerticalTextAlignment="Center"
                           VerticalOptions="Center"/>
                    <Label Text="Login" 
                            FontAttributes="Bold"
                           FontSize="16"
                           VerticalTextAlignment="Center"
                           FontFamily="MonstserratBold"
                            TextColor="{StaticResource Gray950}"
                            TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReturnToLoginPageCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>